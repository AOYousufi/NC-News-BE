{
  "name": "nc-news-be",
  "version": "1.0.0",
  "description": "NC News REST API built with Node.js, Express and PostgreSQL",
  "main": "listen.js",
  "scripts": {
    "setup-dbs": "psql -f ./db/setup.sql",
    "seed": "node ./db/seeds/run-seed.js",
    "test": "jest",
    "prepare": "husky install",
    "app-test": "jest ./__tests__/app.test.js",
    "start": "node listen.js",
    "seed-prod": "NODE_ENV=production npm run seed",
    "dev": "nodemon listen.js",
    "migrate": "node ./db/migrate.js",
    "demo:reset": "npm run setup-dbs && npm run seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AOYousufi/NC-News-BE.git"
  },
  "keywords": [],
  "author": "Ahmad Ozair Yousufi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AOYousufi/NC-News-BE/issues"
  },
  "homepage": "https://github.com/AOYousufi/NC-News-BE#readme",
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-extended": "^2.0.0",
    "pg-format": "^1.0.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.19.2",
    "husky": "^8.0.2",
    "jest-sorted": "^1.0.15",
    "nodemon": "^3.1.4",
    "pg": "^8.7.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  }
}
